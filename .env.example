# Copy this file to .env.local and paste your MongoDB Atlas connection string.
# Atlas: Database -> Connect -> Drivers. Replace <db_password> with your
# database user's password, and add the database name "rumm" before the "?".
# Never commit .env.local.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/rumm?retryWrites=true&w=majority&appName=Cluster0"

# Comma-separated emails that can open /admin. Sign up on the site with one of
# these emails first, then sign in.
ADMIN_EMAILS="you@example.com"

# Razorpay (online payments). Use test keys while building:
# Razorpay Dashboard -> switch to Test Mode -> Account & Settings -> API Keys.
# Leave these empty to offer only cash/UPI on delivery.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Only needed once the site is live: Settings -> Webhooks, events payment.captured and order.paid
RAZORPAY_WEBHOOK_SECRET=""

# Order emails through Resend (https://resend.com). Without a key, emails are
# skipped and logged in the terminal instead. With the test sender below,
# Resend only delivers to the email address of your own Resend account.
RESEND_API_KEY=""
EMAIL_FROM="Rumm <onboarding@resend.dev>"
# Used for links in emails
SITE_URL="http://localhost:3000"

# Shopping assistant (Gemini). Free key: https://aistudio.google.com/apikey
# Leave empty to hide the "Ask Rumm" button.
GEMINI_API_KEY=""
# Optional: pin a model, e.g. if Google renames them. Default: gemini-flash-latest
GEMINI_MODEL=""
